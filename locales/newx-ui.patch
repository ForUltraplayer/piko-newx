+/**
+ * @file NewXNotificationTexts.java
+ * @author: ForUltraplayer
+ * @brief Locale-aware text provider for NewX download notifications.
+ */
+package app.morphe.extension.newx.misc;
+
+import app.morphe.extension.crimera.downloader.engine.NotificationTexts;
+
+import static app.morphe.extension.shared.StringRef.str;
+
+final class NewXNotificationTexts implements NotificationTexts {
+    @Override
+    public String waitingForConnection() {
+        return str("piko_newx_download_waiting");
+    }
+
+    @Override
+    public String cancelAction() {
+        return str("piko_newx_settings_cancel");
+    }
+
+    @Override
+    public String shareAction() {
+        return str("piko_newx_media_sheet_share");
+    }
+
+    @Override
+    public String deleteAction() {
+        return str("piko_newx_post_option_delete");
+    }
+
+    @Override
+    public String retryAction() {
+        return str("piko_newx_retry_action");
+    }
+
+    @Override
+    public String downloadCompleted() {
+        return str("piko_newx_download_completed");
+    }
+
+    @Override
+    public String downloadFailed() {
+        return str("piko_newx_download_failed");
+    }
+
+    @Override
+    public String noConnection() {
+        return str("piko_newx_download_no_connection");
+    }
+
+    @Override
+    public String folderLost() {
+        return str("piko_newx_download_folder_lost");
+    }
+
+    @Override
+    public String shareChooserTitle(String fileName) {
+        return fileName != null && !fileName.isEmpty()
+                ? str("piko_newx_share_file", fileName) : str("piko_newx_media_sheet_share");
+    }
+}
